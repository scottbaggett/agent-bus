#!/usr/bin/env bash
# agent-bus — a file-backed handoff bus for coding agents working on the same repos.
#
# Model: every agent session occupies a "seat" addressed as <tool>/<worktree>
# (e.g. codex/64ef, claude/main). Seats post handoff packets to each other and
# take advisory claims on files. Nothing here is authoritative — claims are
# cooperative, and the bus never blocks or edits anyone's work.
#
# Storage (machine-global, never committed):
#   $AGENT_BUS_HOME/ledger.jsonl   append-only event log (msg | claim | release | resolve | seat)
#   $AGENT_BUS_HOME/msg/<id>.md    packet bodies
#   $AGENT_BUS_HOME/state/<seat>   per-seat read cursor
#   $AGENT_BUS_HOME/state/roles/   per-repo role registry (<repo>.pm holds a seat addr)
#   $AGENT_BUS_HOME/state/watch/   per-seat opt-in Stop-hook wake flags
#   $AGENT_BUS_HOME/seats/<seat>   seat registry (last seen, branch, cwd)
#   $AGENT_BUS_HOME/claims/<hash>  advisory file claims
#
# Roles: one seat per repo may register as PM. A PM receives supervisory packets
# (needs-review, blocked, handoff, question) from anywhere in the repo regardless
# of the sender's --to scope, because the default scope is worktree-local and a
# supervisor is by definition in a different worktree from the work.
#
# Watch: opt-in per seat. When on, the Stop hook continues the agent if there are
# unread supervisory packets (same states as PM auto-CC), capped by MAX_SHOWS.
set -euo pipefail

BUS="${AGENT_BUS_HOME:-$HOME/.agents/bus}"
LEDGER="$BUS/ledger.jsonl"
LOOKBACK_DAYS="${AGENT_BUS_LOOKBACK_DAYS:-3}"
SEAT_TTL="${AGENT_BUS_SEAT_TTL:-7200}"
CLAIM_TTL="${AGENT_BUS_CLAIM_TTL:-14400}"
GC_DAYS="${AGENT_BUS_GC_DAYS:-14}"

die() { printf 'agent-bus: %s\n' "$1" >&2; exit 1; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
require_cmd jq
require_cmd shasum
require_cmd xxd

ensure_bus() {
  mkdir -p "$BUS/msg" "$BUS/state" "$BUS/state/roles" "$BUS/state/watch" "$BUS/seats" "$BUS/claims"
  : >>"$LEDGER"
}

# States that a repo's PM seat receives regardless of the sender's --to scope.
# Also the only states that opt-in watch may wake a seat for on Stop.
PM_STATES='["needs-review","blocked","handoff","question"]'

now_epoch() { date -u +%s; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
slugify() { printf '%s' "$1" | tr '/:@ ' '____'; }

# Human-readable age. Keeps the digest scannable without a date column.
age() {
  local s=$(( $(now_epoch) - $1 ))
  ((s < 0)) && s=0
  if ((s < 60)); then printf '%ds' "$s"
  elif ((s < 3600)); then printf '%dm' "$((s / 60))"
  elif ((s < 86400)); then printf '%dh' "$((s / 3600))"
  else printf '%dd' "$((s / 86400))"; fi
}

# ---------------------------------------------------------------- identity

resolve_identity() {
  TOOL="${AGENT_BUS_TOOL:-}"
  if [ -z "$TOOL" ]; then
    if [ -n "${CLAUDECODE:-}" ]; then TOOL=claude
    elif [ -n "${CODEX_SHELL:-}${CODEX_SANDBOX:-}${CODEX_APP_TITLE:-}" ]; then TOOL=codex
    elif [ -n "${CURSOR_TRACE_ID:-}" ]; then TOOL=cursor
    else TOOL=shell
    fi
  fi

  TOP=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$TOP" ]; then
    local gd cd_
    gd=$(cd "$TOP" && git rev-parse --absolute-git-dir)
    cd_=$(cd "$TOP" && cd "$(git rev-parse --git-common-dir)" && pwd)
    # Display name stays human-readable; stable id is a hash of the git common dir so
    # two clones with the same basename don't share PM roles or claims.
    REPO=$(basename "$(dirname "$cd_")")
    REPO_ID=$(printf '%s' "$cd_" | shasum -a 256 | cut -c1-16)
    if [ "$gd" = "$cd_" ]; then
      WT=main
    else
      local b p
      b=$(basename "$TOP"); p=$(basename "$(dirname "$TOP")")
      # Worktree dirs are commonly <hash>/<repo-name>; prefer the distinguishing segment.
      if [ "$b" = "$REPO" ]; then WT="$p"; else WT="$b"; fi
    fi
    BRANCH=$(cd "$TOP" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')
    [ "$BRANCH" = "HEAD" ] && BRANCH="detached@$(cd "$TOP" && git rev-parse --short HEAD)"
  else
    REPO='-'; WT=$(basename "$PWD"); BRANCH='-'; TOP="$PWD"
    REPO_ID=$(printf '%s' "$TOP" | shasum -a 256 | cut -c1-16)
  fi

  # Optional overrides for tests / explicit seat pinning.
  [ -n "${AGENT_BUS_WT:-}" ] && WT="$AGENT_BUS_WT"
  [ -n "${AGENT_BUS_REPO_ID:-}" ] && REPO_ID="$AGENT_BUS_REPO_ID"

  ADDR="$TOOL/$WT"
  SEAT=$(slugify "$ADDR")
  SESSION="${AGENT_BUS_SESSION:-${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-local}}}"
}

# Seat registry doubles as the peer directory for `who`.
#
# last_hook / last_cli are kept separately so `doctor` can answer "are this
# tool's lifecycle hooks actually firing?" — the one thing that distinguishes
# automatic delivery from an agent that merely ran the command by hand.
touch_seat() {
  local f="$BUS/seats/$SEAT.json" via="${AGENT_BUS_VIA:-cli}" now prev_hook=0 prev_cli=0
  now=$(now_epoch)
  if [ -f "$f" ]; then
    prev_hook=$(jq -r '.last_hook // 0' "$f")
    prev_cli=$(jq -r '.last_cli // 0' "$f")
  fi
  [ "$via" = hook ] && prev_hook="$now" || prev_cli="$now"
  # Claude Code exports its inbox socket to hooks/Bash. Recording it lets `post`
  # push a wake to an idle peer (see poke_seat), the one thing a pull digest
  # cannot do. Empty for tools without the socket (codex/cursor/shell).
  local sock="${CLAUDE_CODE_MESSAGING_SOCKET:-}"
  jq -n -c \
    --arg addr "$ADDR" --arg tool "$TOOL" --arg repo "$REPO" --arg repo_id "$REPO_ID" \
    --arg wt "$WT" --arg branch "$BRANCH" --arg cwd "$TOP" --arg session "$SESSION" \
    --arg via "$via" --arg sock "$sock" --argjson epoch "$now" --argjson last_hook "$prev_hook" \
    --argjson last_cli "$prev_cli" \
    '{addr:$addr,tool:$tool,repo:$repo,repo_id:$repo_id,wt:$wt,branch:$branch,cwd:$cwd,
      session:$session,via:$via,socket:$sock,epoch:$epoch,last_hook:$last_hook,last_cli:$last_cli}' >"$f.tmp"
  mv "$f.tmp" "$f"
}

# ------------------------------------------------------------- push delivery

# Whether a socket path is a live, connectable inbox. A stale seat file can
# name a socket whose session has exited; a data-free connect probe (stdin
# closed immediately, so no frame is enqueued) tells a live listener from a
# stale socket file. `-z` is avoided: macOS nc rejects it on Unix sockets.
socket_live() {
  local sock="$1"
  [ -n "$sock" ] && [ -S "$sock" ] || return 1
  command -v nc >/dev/null 2>&1 || return 1
  nc -U "$sock" -w 1 </dev/null >/dev/null 2>&1
}

# Wake one peer session by writing a Claude Code inbox frame to its socket.
# Frame shape is the harness's own (type:user, message.content); session_id is
# omitted so the poke is not rejected on mismatch. Best-effort: any failure is
# swallowed so delivery never blocks or fails a post.
poke_seat() {
  local sock="$1" text="$2" frame
  command -v nc >/dev/null 2>&1 || return 0
  [ -S "$sock" ] || return 0
  frame=$(jq -nc --arg f "agent-bus" --arg c "$text" \
    '{type:"user",from:$f,message:{content:$c}}') || return 0
  printf '%s\n' "$frame" | nc -U "$sock" -w 2 >/dev/null 2>&1 || true
}

# Seats that should be woken for a packet just posted: same recipient logic as
# select_unread but evaluated sender-side over the live seat registry. Emits
# "<addr>\t<socket>" for each Claude seat with a recorded socket, excluding the
# sender. `to`/`state` are the packet's; `pm` is the repo's PM addr or "".
push_targets() {
  local to="$1" state="$2" pm="$3" f
  for f in "$BUS"/seats/*.json; do
    [ -f "$f" ] || continue
    jq -r \
      --arg addr "$ADDR" --arg tool "$TOOL" --arg repo "$REPO" --arg repoId "$REPO_ID" \
      --arg wt "$WT" --arg to "$to" --arg state "$state" --arg pm "$pm" \
      --argjson pmStates "$PM_STATES" '
      def same_repo:
        (((.repo_id // "") != "") and (.repo_id == $repoId))
        or (((.repo_id // "") == "") and (.repo == $repo));
      select((.socket // "") != "")          # only Claude seats with an inbox
      | select(.addr != $addr)               # never the sender
      | select(
          $to == .addr
          or $to == "@all"
          or ($to == "@here" and (. | same_repo) and .wt == $wt)
          or ($to == "@repo" and (. | same_repo))
          or ($to == ("@" + .tool) and (. | same_repo))
          or ($to == "@pm" and $pm == .addr and (. | same_repo))
          or ($pm == .addr and (. | same_repo) and ($pmStates | index($state)))
        )
      | "\(.addr)\t\(.socket)"
    ' "$f" 2>/dev/null || true
  done
}

# ------------------------------------------------------------------ ledger

# Single-line appends stay under PIPE_BUF so concurrent writers can't interleave;
# packet bodies live in separate files to keep it that way.
ledger_append() { printf '%s\n' "$1" >>"$LEDGER"; }

STATE_FILE() { printf '%s/state/%s.json' "$BUS" "$SEAT"; }

read_ids() {
  local f; f=$(STATE_FILE)
  [ -f "$f" ] && jq -c '.read // []' "$f" || echo '[]'
}

shown_counts() {
  local f; f=$(STATE_FILE)
  [ -f "$f" ] && jq -c '.shown // {}' "$f" || echo '{}'
}

# A hook-run digest cannot prove its stdout reached a model — the host may not
# inject it at all. So only an agent-invoked `read` marks a packet read;
# `digest` merely counts how many times it has been surfaced, and gives up after
# MAX_SHOWS so an undeliverable packet can't spam every prompt forever.
MAX_SHOWS="${AGENT_BUS_MAX_SHOWS:-3}"
# Per-seat Stop-hook wake budget across DISTINCT packets (not per id). Bounds
# watch ping-pong between well-behaved seats. Resets only on `resolve` (thread
# closed) — never on `read`, which is exactly what a woken agent must do.
WAKE_BUDGET="${AGENT_BUS_WAKE_BUDGET:-3}"

# Rewrite seat state preserving unrelated fields (e.g. wake_pending).
write_state() {
  local f read_json shown_json wake_n epoch_field epoch_val prev
  f=$(STATE_FILE)
  read_json="$1"
  shown_json="$2"
  wake_n="$3"
  epoch_field="$4"
  epoch_val="$5"
  # Do not use ${var:-{}} — bash parses the nested } as end of expansion.
  [ -n "$read_json" ] || read_json='[]'
  [ -n "$shown_json" ] || shown_json='{}'
  [ -n "$wake_n" ] || wake_n=0
  [[ "$wake_n" =~ ^[0-9]+$ ]] || wake_n=0
  [[ "$epoch_val" =~ ^[0-9]+$ ]] || epoch_val=$(now_epoch)
  prev='{}'
  [ -f "$f" ] && prev=$(jq -c . "$f" 2>/dev/null || echo '{}')
  [ -n "$prev" ] || prev='{}'
  jq -n -c \
    --argjson prev "$prev" \
    --argjson read "$read_json" --argjson shown "$shown_json" --argjson wake "$wake_n" \
    --arg ef "$epoch_field" --argjson ev "$epoch_val" \
    '$prev * {read:$read, shown:$shown, wake_count:$wake} + {($ef): $ev}' >"$f.tmp"
  mv "$f.tmp" "$f"
}

mark_read() {
  # Preserve wake_count — read is what woken agents do; resetting here made
  # well-behaved ping-pong unbounded (PM blocker 1).
  local merged wake
  merged="${1:-[]}"
  [ -n "$merged" ] || merged='[]'
  wake=$(wake_count)
  write_state "$merged" "$(shown_counts)" "$wake" last_read "$(now_epoch)"
}

bump_shown() {
  local ids="$1" new_shown wake
  # -n required: $(...) provides empty stdin and jq would emit nothing.
  new_shown=$(jq -n -c --argjson ids "$ids" --argjson cur "$(shown_counts)" \
    'reduce $ids[] as $i ($cur; .[$i] = ((.[$i] // 0) + 1))')
  [ -n "$new_shown" ] || new_shown='{}'
  wake=$(wake_count)
  [[ "$wake" =~ ^[0-9]+$ ]] || wake=0
  write_state "$(read_ids)" "$new_shown" "$wake" last_shown "$(now_epoch)"
}

bump_wake() {
  local ids="$1" new_shown wake
  new_shown=$(jq -n -c --argjson ids "$ids" --argjson cur "$(shown_counts)" \
    'reduce $ids[] as $i ($cur; .[$i] = ((.[$i] // 0) + 1))')
  [ -n "$new_shown" ] || new_shown='{}'
  wake=$(( $(wake_count) + 1 ))
  write_state "$(read_ids)" "$new_shown" "$wake" last_wake "$(now_epoch)"
}

reset_wake() {
  write_state "$(read_ids)" "$(shown_counts)" 0 last_wake_reset "$(now_epoch)"
  set_wake_pending 0
}

wake_count() {
  local f n=0
  f=$(STATE_FILE)
  if [ -f "$f" ]; then
    n=$(jq -r '.wake_count // 0' "$f" 2>/dev/null || echo 0)
  fi
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  printf '%s' "$n"
}

# Supervisory unread count ignoring MAX_SHOWS (for exhaustion diagnostics).
pending_wake_count() {
  local n
  n=$(select_unread 0 0 1 2>/dev/null | grep -c . || true)
  printf '%s' "${n:-0}"
}

set_wake_pending() {
  local pending="${1:-0}" f
  f=$(STATE_FILE)
  [[ "$pending" =~ ^[0-9]+$ ]] || pending=0
  if [ ! -f "$f" ]; then
    write_state '[]' '{}' "$(wake_count)" last_wake_pending "$(now_epoch)"
  fi
  jq -c --argjson p "$pending" --argjson e "$(now_epoch)" \
    '. + {wake_pending:$p, last_wake_pending:$e}' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

resolved_ids() { jq -sc '[.[] | select(.kind=="resolve") | .msg]' "$LEDGER"; }

# ------------------------------------------------------------------- roles

# Stable key for PM/claims. Prefer repo_id; legacy callers may pass a display name.
pm_file() {
  local key="${1:-$REPO_ID}"
  printf '%s/state/roles/%s.pm' "$BUS" "$(slugify "$key")"
}

# Seat address of the repo's PM, or empty. Never fails — callers treat "" as none.
# Migrates legacy name-based role files (pre-repo_id) on first read.
pm_seat() {
  local id_f name_f
  id_f=$(pm_file "${1:-$REPO_ID}")
  if [ -f "$id_f" ]; then cat "$id_f"; return; fi
  # Only migrate when looking up the current repo (no explicit override).
  if [ -z "${1:-}" ]; then
    name_f=$(pm_file "$REPO")
    if [ -f "$name_f" ]; then
      cp "$name_f" "$id_f"
      cat "$id_f"
      return
    fi
  fi
  printf ''
}

# Messages this seat should see: addressed to it (directly or by scope),
# not sent by it, not resolved, not already read, within the lookback window.
# Args: include_read digest_mode wake_mode
# wake_mode=1 keeps only supervisory states (PM_STATES) for Stop-hook wake.
select_unread() {
  local include_read="${1:-0}" digest_mode="${2:-0}" wake_mode="${3:-0}" cut
  cut=$(( $(now_epoch) - LOOKBACK_DAYS * 86400 ))
  jq -c \
    --arg addr "$ADDR" --arg tool "$TOOL" --arg repo "$REPO" --arg repoId "$REPO_ID" \
    --arg wt "$WT" --arg pm "$(pm_seat)" --argjson pmStates "$PM_STATES" \
    --argjson cut "$cut" --argjson read "$(read_ids)" --argjson resolved "$(resolved_ids)" \
    --argjson includeRead "$include_read" --argjson digest "$digest_mode" \
    --argjson wake "$wake_mode" \
    --argjson shown "$(shown_counts)" --argjson maxShows "$MAX_SHOWS" '
    def same_repo:
      (((.repo_id // "") != "") and (.repo_id == $repoId))
      or (((.repo_id // "") == "") and (.repo == $repo));
    select(.kind == "msg")
    | . as $m
    | select($m.epoch >= $cut)
    | select($m.from != $addr)
    | select(
        $m.to == $addr
        or $m.to == "@all"
        or ($m.to == "@here" and ($m | same_repo) and $m.wt == $wt)
        or ($m.to == "@repo" and ($m | same_repo))
        or ($m.to == ("@" + $tool) and ($m | same_repo))
        or ($m.to == "@pm" and $pm == $addr and ($m | same_repo))
        # Supervisory auto-CC: the PM sees lifecycle traffic anywhere in the repo,
        # because senders default to @here and a PM is never in their worktree.
        or ($pm == $addr and ($m | same_repo) and ($pmStates | index($m.state)))
      )
    | select($resolved | index($m.id) | not)
    | select($includeRead == 1 or ($read | index($m.id) | not))
    | select($digest == 0 or (($shown[$m.id] // 0) < $maxShows))
    | select($wake == 0 or ($pmStates | index($m.state)))
  ' "$LEDGER"
}

# ------------------------------------------------------------------- watch

watch_file() { printf '%s/state/watch/%s.json' "$BUS" "$SEAT"; }

watch_on() { [ -f "$(watch_file)" ] && jq -e '.on == true' "$(watch_file)" >/dev/null 2>&1; }

watch_set() {
  local on="$1" f
  f=$(watch_file)
  mkdir -p "$(dirname "$f")"
  if [ "$on" = 1 ]; then
    jq -n -c --arg addr "$ADDR" --argjson epoch "$(now_epoch)" \
      '{on:true,addr:$addr,epoch:$epoch}' >"$f.tmp"
    mv "$f.tmp" "$f"
  else
    rm -f "$f"
  fi
}

seat_watch_on() {
  local seat="$1" f
  f="$BUS/state/watch/${seat}.json"
  [ -f "$f" ] && jq -e '.on == true' "$f" >/dev/null 2>&1
}

# ------------------------------------------------------------------ claims

claim_key() { printf '%s' "$1:$2" | shasum -a 256 | cut -c1-16; } # args: repo_key path

# New (repo_id) and legacy (display-name) claim file paths for a normalized path.
claim_file_new() { printf '%s/claims/%s.json' "$BUS" "$(claim_key "$REPO_ID" "$1")"; }
claim_file_legacy() { printf '%s/claims/%s.json' "$BUS" "$(claim_key "$REPO" "$1")"; }

# Move a legacy-keyed claim to the repo_id key when the new file is absent.
# Lock + non-fatal mv so a concurrent claim cannot crash the process under set -e.
migrate_claim_file() {
  local np="$1" newf legacyf lock key
  newf=$(claim_file_new "$np"); legacyf=$(claim_file_legacy "$np")
  [ "$newf" = "$legacyf" ] && return 0
  [ -f "$legacyf" ] || return 0
  [ -f "$newf" ] && return 0
  key=$(claim_key "$REPO_ID" "$np")
  lock="$BUS/claims/.migrate-${key}.lock"
  if mkdir "$lock" 2>/dev/null; then
    # Re-check inside the lock.
    if [ -f "$legacyf" ] && [ ! -f "$newf" ]; then
      mv "$legacyf" "$newf" 2>/dev/null || true
    fi
    rmdir "$lock" 2>/dev/null || true
  fi
  # Loser of the race: new may now exist (winner migrated) or legacy remains.
  return 0
}

# Print "addr epoch" of a live FOREIGN holder on either key scheme, or empty.
# Checks both new (repo_id) and legacy (display-name) files so pre-upgrade
# claims still contest and remain releasable by their holder.
claim_foreign_holder() {
  local np="$1" cut=$(( $(now_epoch) - CLAIM_TTL ))
  local newf legacyf f holder hepoch
  newf=$(claim_file_new "$np"); legacyf=$(claim_file_legacy "$np")
  for f in "$newf" "$legacyf"; do
    [ -f "$f" ] || continue
    holder=$(jq -r '.addr // empty' "$f" 2>/dev/null || true)
    hepoch=$(jq -r '.epoch // 0' "$f" 2>/dev/null || echo 0)
    [[ "$hepoch" =~ ^[0-9]+$ ]] || hepoch=0
    ((hepoch < cut)) && continue
    [ "$holder" = "$ADDR" ] && continue
    [ -z "$holder" ] && continue
    printf '%s %s' "$holder" "$hepoch"
    return 0
  done
  printf ''
}

# Repo-relative where possible so the same file claimed from two worktrees collides.
normalize_path() {
  local p="$1"
  if [ -n "$TOP" ] && [ "$REPO" != '-' ]; then
    local abs
    abs=$(cd "$(dirname "$p")" 2>/dev/null && pwd)/$(basename "$p") || abs="$p"
    case "$abs" in "$TOP"/*) printf '%s' "${abs#"$TOP"/}"; return ;; esac
  fi
  printf '%s' "$p"
}

live_claims() {
  local cut=$(( $(now_epoch) - CLAIM_TTL ))
  find "$BUS/claims" -name '*.json' -type f 2>/dev/null | while read -r f; do
    local e
    e=$(jq -r '.epoch // 0' "$f" 2>/dev/null || echo 0)
    [[ "$e" =~ ^[0-9]+$ ]] || continue
    ((e < cut)) && continue
    jq -c . "$f" 2>/dev/null || true
  done
}

# ---------------------------------------------------------------- commands

cmd_whoami() {
  local watch_status=off
  watch_on && watch_status=on
  printf 'seat     %s\nsession  %s\nrepo     %s\nrepo_id  %s\nworktree %s\nbranch   %s\nwatch    %s\ncwd      %s\nbus      %s\n' \
    "$ADDR" "$SESSION" "$REPO" "$REPO_ID" "$WT" "$BRANCH" "$watch_status" "$TOP" "$BUS"
}

cmd_who() {
  local cut=$(( $(now_epoch) - SEAT_TTL )) found=0
  printf 'seats active in the last %dm:\n' "$((SEAT_TTL / 60))"
  for f in "$BUS"/seats/*.json; do
    [ -f "$f" ] || continue
    local e seat_slug addr mark
    e=$(jq -r '.epoch' "$f")
    ((e < cut)) && continue
    found=1
    addr=$(jq -r '.addr' "$f")
    seat_slug=$(basename "$f" .json)
    mark=""
    [ "$addr" = "$ADDR" ] && mark="  <- you"
    seat_watch_on "$seat_slug" && mark="${mark}  watch"
    printf '  %-22s %-14s %-46s %s ago%s\n' \
      "$addr" "$(jq -r '.repo' "$f")" "$(jq -r '.branch' "$f")" \
      "$(age "$e")" "$mark"
  done
  ((found)) || printf '  (none)\n'
  local pm; pm=$(pm_seat)
  if [ -n "$pm" ]; then
    printf '\nPM for %s: %s%s\n' "$REPO" "$pm" "$([ "$pm" = "$ADDR" ] && echo '  <- you')"
    printf '  auto-CC: needs-review, blocked, handoff, question (any worktree)\n'
  fi
  local claims; claims=$(live_claims)
  if [ -n "$claims" ]; then
    printf '\nactive claims:\n'
    printf '%s\n' "$claims" | jq -r '"  \(.addr) -> \(.path)"'
  fi
}

cmd_post() {
  local to='@here' state='fyi' subject='' body='' bodyfile='' touched='[]' re='null'
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --state) state="$2"; shift 2 ;;
      --subject|-s) subject="$2"; shift 2 ;;
      -m|--message) body="$2"; shift 2 ;;
      --file|-f) bodyfile="$2"; shift 2 ;;
      --re) re="\"$2\""; shift 2 ;;
      --touched)
        if [ "$2" = auto ]; then
          touched=$( { git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } \
            | head -20 | jq -Rsc 'split("\n") | map(select(length>0))')
        else
          touched=$(printf '%s' "$2" | jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))')
        fi
        shift 2 ;;
      *) die "post: unknown flag $1" ;;
    esac
  done

  case "$state" in needs-review|blocked|done|fyi|question|handoff) ;; *) die "post: --state must be one of needs-review|blocked|done|fyi|question|handoff" ;; esac
  if [ "$to" = "@pm" ] && [ -z "$(pm_seat)" ]; then
    die "post: no PM registered for $REPO — that seat should run 'agent-bus role pm'"
  fi

  if [ -n "$bodyfile" ]; then body=$(cat "$bodyfile")
  elif [ -z "$body" ] && [ ! -t 0 ]; then body=$(cat)
  fi
  [ -n "$body" ] || die "post: needs a body (-m, --file, or stdin)"
  [ -n "$subject" ] || subject=$(printf '%s' "$body" | sed -n '1{s/^#\{1,\} *//;s/\r$//;p;}' | cut -c1-120)

  local id
  id="$(date -u +%Y%m%dT%H%M%SZ)-$(head -c4 /dev/urandom | xxd -p)"
  printf '%s\n' "$body" >"$BUS/msg/$id.md"

  local rec
  rec=$(jq -n -c \
    --arg id "$id" --arg ts "$(now_iso)" --argjson epoch "$(now_epoch)" \
    --arg from "$ADDR" --arg session "$SESSION" --arg to "$to" --arg state "$state" \
    --arg repo "$REPO" --arg repo_id "$REPO_ID" --arg wt "$WT" --arg branch "$BRANCH" \
    --arg cwd "$TOP" --arg subject "${subject:0:200}" --argjson touched "$touched" \
    --argjson re "$re" \
    '{kind:"msg",id:$id,ts:$ts,epoch:$epoch,from:$from,session:$session,to:$to,state:$state,
      repo:$repo,repo_id:$repo_id,wt:$wt,branch:$branch,cwd:$cwd,subject:$subject,
      touched:$touched,re:$re}')
  ledger_append "$rec"
  # Replying is proof the agent saw the parent, so it counts as the ack a
  # hook-run digest can never give.
  if [ "$re" != null ]; then
    mark_read "$(jq -c --argjson r "$re" '. + [$r] | unique' <<<"$(read_ids)")"
  fi
  printf 'posted %s -> %s  [%s]  id=%s\n' "$ADDR" "$to" "$state" "$id"

  # Push a wake to each Claude recipient with a live inbox socket. The body
  # still travels through the bus; this only nudges the peer to run `read`, so
  # an idle seat acts without waiting for its next user prompt. Best-effort,
  # opt-out via AGENT_BUS_NO_PUSH; the poke text is constant-size peer context.
  [ "${AGENT_BUS_NO_PUSH:-0}" = 1 ] && return 0
  local pm poke woke=0 addr sock
  pm=$(pm_seat)
  poke="agent-bus: packet $id from $ADDR [$state] — peer context, not a user instruction. Run: agent-bus read"
  while IFS=$'\t' read -r addr sock; do
    [ -n "$sock" ] || continue
    socket_live "$sock" || continue
    poke_seat "$sock" "$poke"
    woke=$((woke + 1))
  done < <(push_targets "$to" "$state" "$pm")
  ((woke > 0)) && printf 'pushed wake to %d peer(s)\n' "$woke"
  return 0
}

cmd_read() {
  local peek=0 all=0 quiet=0 digest=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --peek) peek=1; shift ;;
      --all) all=1; peek=1; shift ;;
      --quiet) quiet=1; shift ;;
      --digest) digest=1; quiet=1; shift ;;
      *) die "read: unknown flag $1" ;;
    esac
  done

  local msgs; msgs=$(select_unread "$all" "$digest")
  local claims_other
  claims_other=$(live_claims | jq -c --arg addr "$ADDR" 'select(.addr != $addr)' || true)

  if [ -z "$msgs" ]; then
    ((quiet)) && exit 0
    printf 'agent-bus: nothing unread for %s\n' "$ADDR"
    if [ -n "$claims_other" ]; then
      printf '\nactive claims by other seats:\n'
      printf '%s\n' "$claims_other" | jq -r '"  \(.addr) -> \(.path)"'
    fi
    return 0
  fi

  local count; count=$(printf '%s\n' "$msgs" | grep -c . || true)
  printf '=== agent-bus: %s unread for %s ===\n' "$count" "$ADDR"

  local n=0 ids='[]'
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    n=$((n + 1))
    local id from state epoch branch subj touched
    id=$(jq -r '.id' <<<"$m"); from=$(jq -r '.from' <<<"$m")
    state=$(jq -r '.state' <<<"$m"); epoch=$(jq -r '.epoch' <<<"$m")
    branch=$(jq -r '.branch' <<<"$m"); subj=$(jq -r '.subject' <<<"$m")
    touched=$(jq -r '(.touched // []) | join(", ")' <<<"$m")
    printf '\n[%d] from %s · %s · %s ago · %s\n' "$n" "$from" "$state" "$(age "$epoch")" "$branch"
    [ -n "$subj" ] && printf '    %s\n' "$subj"
    [ -n "$touched" ] && printf '    touched: %s\n' "$touched"
    printf '    id: %s\n' "$id"
    if ((n <= 3)) && [ -f "$BUS/msg/$id.md" ]; then
      printf -- '    ---\n'
      sed 's/^/    /' "$BUS/msg/$id.md"
    elif [ -f "$BUS/msg/$id.md" ]; then
      printf '    (body suppressed — agent-bus show %s)\n' "$id"
    fi
    ids=$(jq -c --arg id "$id" '. + [$id]' <<<"$ids")
  done <<<"$msgs"

  if [ -n "$claims_other" ]; then
    printf '\nactive claims by other seats:\n'
    printf '%s\n' "$claims_other" | jq -r '"  \(.addr) -> \(.path)"'
  fi
  printf '\nreply: agent-bus post --re <id> --to <seat> --state done -m "..."\n'
  printf 'close: agent-bus resolve <id>\n'
  ((digest)) && printf 'ack:   agent-bus read   (marks these read; a hook digest never does)\n'

  if ((peek)); then :
  elif ((digest)); then bump_shown "$ids"
  else mark_read "$(jq -c --argjson new "$ids" '. + $new | unique' <<<"$(read_ids)")"
  fi
}

cmd_show() {
  local json=0
  [ "${1:-}" = --json ] && { json=1; shift; }
  [ $# -ge 1 ] || die "show: needs a message id"
  # --json emits only the record, so `show --json <id> | jq` is safe; the default
  # form appends the markdown body and is for humans.
  jq -c --arg id "$1" 'select(.kind=="msg" and .id==$id)' "$LEDGER"
  if ((!json)) && [ -f "$BUS/msg/$1.md" ]; then
    printf -- '---\n'; cat "$BUS/msg/$1.md"
  fi
  return 0
}

cmd_resolve() {
  [ $# -ge 1 ] || die "resolve: needs a message id"
  for id in "$@"; do
    ledger_append "$(jq -n -c --arg msg "$id" --arg by "$ADDR" --argjson epoch "$(now_epoch)" \
      '{kind:"resolve",msg:$msg,by:$by,epoch:$epoch}')"
    printf 'resolved %s\n' "$id"
  done
  # Closing a thread is the only automatic wake-budget reset — read must not.
  reset_wake
}

cmd_claim() {
  [ $# -ge 1 ] || die "claim: needs one or more paths"
  for p in "$@"; do
    local np newf legacyf info holder hepoch
    np=$(normalize_path "$p")
    migrate_claim_file "$np"
    newf=$(claim_file_new "$np"); legacyf=$(claim_file_legacy "$np")
    info=$(claim_foreign_holder "$np")
    if [ -n "$info" ]; then
      holder=${info%% *}; hepoch=${info##* }
      printf 'CONTESTED %s — held by %s (%s ago)\n' "$np" "$holder" "$(age "$hepoch")" >&2
      continue
    fi
    # One path → one record under the repo_id key; drop leftover legacy.
    [ "$legacyf" != "$newf" ] && rm -f "$legacyf"
    jq -n -c --arg addr "$ADDR" --arg repo "$REPO" --arg repo_id "$REPO_ID" \
      --arg path "$np" --arg branch "$BRANCH" --argjson epoch "$(now_epoch)" \
      '{addr:$addr,repo:$repo,repo_id:$repo_id,path:$path,branch:$branch,epoch:$epoch}' >"$newf"
    ledger_append "$(jq -n -c --arg addr "$ADDR" --arg repo "$REPO" --arg repo_id "$REPO_ID" \
      --arg path "$np" --argjson epoch "$(now_epoch)" \
      '{kind:"claim",addr:$addr,repo:$repo,repo_id:$repo_id,path:$path,epoch:$epoch}')"
    printf 'claimed %s\n' "$np"
  done
}

cmd_release() {
  if [ "${1:-}" = --all ]; then
    for f in "$BUS"/claims/*.json; do
      [ -f "$f" ] || continue
      [ "$(jq -r '.addr' "$f")" = "$ADDR" ] && rm -f "$f"
    done
    printf 'released all claims held by %s\n' "$ADDR"
    return
  fi
  [ $# -ge 1 ] || die "release: needs paths or --all"
  for p in "$@"; do
    local np newf legacyf info holder hepoch
    np=$(normalize_path "$p")
    newf=$(claim_file_new "$np"); legacyf=$(claim_file_legacy "$np")
    if [ ! -f "$newf" ] && [ ! -f "$legacyf" ]; then
      printf 'released %s (not held)\n' "$np"
      continue
    fi
    info=$(claim_foreign_holder "$np")
    if [ -n "$info" ]; then
      holder=${info%% *}; hepoch=${info##* }
      printf 'agent-bus: %s held by %s — not releasing\n' "$np" "$holder" >&2
      continue
    fi
    # Holder (or expired) on either key scheme — clear both.
    rm -f "$newf" "$legacyf"
    printf 'released %s\n' "$np"
  done
}

cmd_claims() {
  local c; c=$(live_claims)
  [ -n "$c" ] || { printf '(no active claims)\n'; return; }
  if command -v column >/dev/null 2>&1; then
    printf '%s\n' "$c" | jq -r '"\(.addr)\t\(.repo)\t\(.path)"' | column -t -s "$(printf '\t')"
  else
    printf '%s\n' "$c" | jq -r '"\(.addr)  \(.repo)  \(.path)"'
  fi
}

cmd_log() {
  local n="${1:-20}"
  tail -n 200 "$LEDGER" | jq -rc 'select(.kind=="msg") |
    "\(.ts)  \(.from) -> \(.to)  [\(.state)]  \(.subject)  (\(.id))"' | tail -n "$n"
}

cmd_doctor() {
  cmd_whoami
  printf '\nledger  %s lines\nmsgs    %s\nseats   %s\nclaims  %s\n' \
    "$(wc -l <"$LEDGER" | tr -d ' ')" \
    "$(find "$BUS/msg" -name '*.md' 2>/dev/null | wc -l | tr -d ' ')" \
    "$(find "$BUS/seats" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')" \
    "$(find "$BUS/claims" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')"
  printf '\nwatch on:\n'
  local any_watch=0
  for f in "$BUS"/state/watch/*.json; do
    [ -f "$f" ] || continue
    jq -e '.on == true' "$f" >/dev/null 2>&1 || continue
    any_watch=1
    printf '  %s\n' "$(jq -r '.addr // empty' "$f")"
  done
  ((any_watch)) || printf '  (none)\n'

  # Wake budget exhaustion with unseen supervisory mail — distinct from quiet.
  local any_exh=0
  for f in "$BUS"/state/*.json; do
    [ -f "$f" ] || continue
    local seat wc wp
    seat=$(basename "$f" .json)
    wc=$(jq -r '.wake_count // 0' "$f" 2>/dev/null || echo 0)
    wp=$(jq -r '.wake_pending // 0' "$f" 2>/dev/null || echo 0)
    [[ "$wc" =~ ^[0-9]+$ ]] || wc=0
    [[ "$wp" =~ ^[0-9]+$ ]] || wp=0
    ((wc < WAKE_BUDGET)) && continue
    # Live pending for this seat; fall back to last recorded wake_pending.
    if [ "$seat" = "$SEAT" ]; then
      wp=$(pending_wake_count)
    fi
    ((any_exh)) || printf '\nwake budget exhausted (Stop will not continue):\n'
    any_exh=1
    if ((wp > 0)); then
      printf '  %-22s wake %s/%s — %s supervisory pending (unseen by Stop)\n' \
        "$seat" "$wc" "$WAKE_BUDGET" "$wp"
    else
      printf '  %-22s wake %s/%s — exhausted, nothing pending\n' \
        "$seat" "$wc" "$WAKE_BUDGET"
    fi
  done

  printf '\nlifecycle hooks per seat:\n'
  local any=0
  for f in "$BUS"/seats/*.json; do
    [ -f "$f" ] || continue
    any=1
    local addr lh lc
    addr=$(jq -r '.addr' "$f"); lh=$(jq -r '.last_hook // 0' "$f"); lc=$(jq -r '.last_cli // 0' "$f")
    if [ "$lh" != 0 ]; then
      printf '  %-22s hooks FIRING (last %s ago)\n' "$addr" "$(age "$lh")"
    elif [ "$lc" != 0 ]; then
      printf '  %-22s hooks NOT SEEN — cli only (last %s ago)\n' "$addr" "$(age "$lc")"
    else
      printf '  %-22s no telemetry yet\n' "$addr"
    fi
  done
  ((any)) || printf '  (no seats registered yet)\n'

  # Push reachability: which live seats can be woken at post time vs. which
  # depend on the pull digest / watch fallback (codex, cursor, dead sockets).
  printf '\npush delivery (post-time wake):\n'
  local cut_push=$(( $(now_epoch) - SEAT_TTL )) any_push=0
  for f in "$BUS"/seats/*.json; do
    [ -f "$f" ] || continue
    local e addr sock
    e=$(jq -r '.epoch // 0' "$f" 2>/dev/null || echo 0)
    [[ "$e" =~ ^[0-9]+$ ]] || continue
    ((e < cut_push)) && continue
    any_push=1
    addr=$(jq -r '.addr' "$f")
    sock=$(jq -r '.socket // ""' "$f")
    if [ -z "$sock" ]; then
      printf '  %-22s pull only (no inbox socket)\n' "$addr"
    elif socket_live "$sock"; then
      printf '  %-22s PUSH-reachable\n' "$addr"
    else
      printf '  %-22s socket stale — pull only\n' "$addr"
    fi
  done
  ((any_push)) || printf '  (no active seats)\n'

  # Surfaced MAX_SHOWS times and still never acked = that host is not injecting
  # hook stdout into its model's context. The AGENTS.md layer has to carry it.
  local stale=0
  for f in "$BUS"/state/*.json; do
    [ -f "$f" ] || continue
    local seat n
    seat=$(basename "$f" .json)
    n=$(jq --argjson max "$MAX_SHOWS" '[.shown // {} | to_entries[]
      | select(.value >= $max)] | length' "$f")
    if [ "$n" != 0 ]; then
      ((stale)) || printf '\nunacked after %s surfacings (host likely drops hook stdout):\n' "$MAX_SHOWS"
      stale=1
      printf '  %-22s %s packet(s)\n' "$seat" "$n"
    fi
  done
}

cmd_role() {
  local clear=0 role='' key="$REPO_ID" label="$REPO" use_default=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --clear) clear=1; shift ;;
      --repo) label="$2"; key="$2"; use_default=0; shift 2 ;;
      pm) role=pm; shift ;;
      *) die "role: unknown argument $1 (expected: pm, --clear, --repo <name-or-id>)" ;;
    esac
  done

  local f cur legacy_f=""
  # Default lookup must call pm_seat with no args so legacy name-based files migrate.
  if ((use_default)); then
    cur=$(pm_seat)
    f=$(pm_file "$REPO_ID")
    legacy_f=$(pm_file "$REPO")
  else
    f=$(pm_file "$key"); cur=$(pm_seat "$key")
  fi

  if ((clear)); then
    if [ -z "$cur" ] && { [ -z "$legacy_f" ] || [ ! -f "$legacy_f" ]; }; then
      printf 'no PM registered for %s\n' "$label"; return
    fi
    [ -z "$cur" ] || [ "$cur" = "$ADDR" ] || \
      printf 'agent-bus: releasing PM held by another seat (%s)\n' "$cur" >&2
    rm -f "$f"
    [ -n "$legacy_f" ] && rm -f "$legacy_f"
    printf 'PM role cleared for %s\n' "$label"
    return
  fi

  if [ -z "$role" ]; then
    if [ -n "$cur" ]; then printf 'PM for %s: %s\n' "$label" "$cur"
    else printf 'no PM registered for %s\n' "$label"; fi
    return
  fi

  mkdir -p "$(dirname "$f")"
  printf '%s' "$ADDR" >"$f"
  [ -n "$legacy_f" ] && rm -f "$legacy_f"
  if [ -n "$cur" ] && [ "$cur" != "$ADDR" ]; then
    printf 'PM for %s: %s (took over from %s)\n' "$label" "$ADDR" "$cur"
  else
    printf 'PM for %s: %s\n' "$label" "$ADDR"
  fi
  printf 'now receiving needs-review, blocked, handoff, question from any worktree\n'
}

# Drop expired claims, stale seats, and message bodies older than GC_DAYS whose
# ledger rows are outside the lookback window. Ledger lines are kept (append-only)
# but orphaned bodies and dead registry files are removed.
cmd_gc() {
  if (( GC_DAYS < LOOKBACK_DAYS )); then
    die "gc: AGENT_BUS_GC_DAYS ($GC_DAYS) must be >= AGENT_BUS_LOOKBACK_DAYS ($LOOKBACK_DAYS)"
  fi
  local cut_claim=$(( $(now_epoch) - CLAIM_TTL ))
  local cut_seat=$(( $(now_epoch) - SEAT_TTL ))
  local cut_msg=$(( $(now_epoch) - GC_DAYS * 86400 ))
  local n_claim=0 n_seat=0 n_msg=0

  for f in "$BUS"/claims/*.json; do
    [ -f "$f" ] || continue
    local e; e=$(jq -r '.epoch // 0' "$f" 2>/dev/null || echo 0)
    [[ "$e" =~ ^[0-9]+$ ]] || continue
    if ((e < cut_claim)); then rm -f "$f"; n_claim=$((n_claim + 1)); fi
  done

  for f in "$BUS"/seats/*.json; do
    [ -f "$f" ] || continue
    local e; e=$(jq -r '.epoch // 0' "$f" 2>/dev/null || echo 0)
    [[ "$e" =~ ^[0-9]+$ ]] || continue
    if ((e < cut_seat)); then rm -f "$f"; n_seat=$((n_seat + 1)); fi
  done

  # Only purge bodies older than GC_DAYS (and therefore outside lookback).
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    [ -f "$BUS/msg/$id.md" ] || continue
    rm -f "$BUS/msg/$id.md"
    n_msg=$((n_msg + 1))
  done < <(jq -r --argjson cut "$cut_msg" \
    'select(.kind=="msg" and (.epoch | type == "number") and .epoch < $cut) | .id' \
    "$LEDGER" 2>/dev/null || true)

  printf 'gc: removed %s expired claims, %s stale seats, %s old message bodies (>%sd)\n' \
    "$n_claim" "$n_seat" "$n_msg" "$GC_DAYS"
}

cmd_watch() {
  case "${1:-}" in
    on)
      # Do not reset wake_count — toggling watch must not bypass the budget.
      watch_set 1
      printf 'watch on for %s — Stop hook will continue on supervisory unread (budget %s; resets on resolve)\n' \
        "$ADDR" "$WAKE_BUDGET"
      ;;
    off)
      watch_set 0
      printf 'watch off for %s\n' "$ADDR"
      ;;
    reset)
      reset_wake
      printf 'wake budget reset for %s (0/%s)\n' "$ADDR" "$WAKE_BUDGET"
      ;;
    ''|status)
      if watch_on; then
        local wc pending
        wc=$(wake_count)
        pending=$(pending_wake_count)
        if ((wc >= WAKE_BUDGET)); then
          if ((pending > 0)); then
            printf 'watch on for %s (wake EXHAUSTED %s/%s, %s supervisory pending)\n' \
              "$ADDR" "$wc" "$WAKE_BUDGET" "$pending"
          else
            printf 'watch on for %s (wake EXHAUSTED %s/%s, nothing pending)\n' \
              "$ADDR" "$wc" "$WAKE_BUDGET"
          fi
        else
          printf 'watch on for %s (wake %s/%s)\n' "$ADDR" "$wc" "$WAKE_BUDGET"
        fi
      else
        printf 'watch off for %s\n' "$ADDR"
      fi
      ;;
    *) die "watch: expected on|off|status|reset" ;;
  esac
}

# Build WAKE_REASON + WAKE_IDS from supervisory unread (globals; no subshell).
# Does not mark read; caller bumps shown so MAX_SHOWS caps loops.
build_wake_payload() {
  local msgs="$1" tmp count n=0 ids='[]'
  count=$(printf '%s\n' "$msgs" | grep -c . || true)
  tmp=$(mktemp)
  {
    printf 'agent-bus: %s supervisory packet(s) for %s — act before new work.\n' "$count" "$ADDR"
    printf 'Run: agent-bus read\n'
    printf 'Wake states: needs-review, blocked, handoff, question. Ack with read or --re.\n'
    printf 'Wake budget resets only on agent-bus resolve (not on read).\n'
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      n=$((n + 1))
      local id from state epoch branch subj
      id=$(jq -r '.id' <<<"$m"); from=$(jq -r '.from' <<<"$m")
      state=$(jq -r '.state' <<<"$m"); epoch=$(jq -r '.epoch' <<<"$m")
      branch=$(jq -r '.branch' <<<"$m"); subj=$(jq -r '.subject' <<<"$m")
      printf '\n[%d] from %s · %s · %s ago · %s\n' "$n" "$from" "$state" "$(age "$epoch")" "$branch"
      [ -n "$subj" ] && printf '    %s\n' "$subj"
      printf '    id: %s\n' "$id"
      if ((n <= 3)) && [ -f "$BUS/msg/$id.md" ]; then
        printf -- '    ---\n'
        sed 's/^/    /' "$BUS/msg/$id.md"
      elif [ -f "$BUS/msg/$id.md" ]; then
        printf '    (body suppressed — agent-bus show %s)\n' "$id"
      fi
      ids=$(jq -c --arg id "$id" '. + [$id]' <<<"$ids")
    done <<<"$msgs"
  } >"$tmp"
  WAKE_REASON=$(cat "$tmp")
  rm -f "$tmp"
  WAKE_IDS="$ids"
  WAKE_COUNT="$count"
}

# Lifecycle Stop hook entrypoint. Always emits a single JSON object on stdout.
# When watch is on and supervisory unread exists (under MAX_SHOWS and the
# per-seat WAKE_BUDGET), blocks stop with the digest as the continuation
# reason (Claude/Codex). Cursor maps this to followup_message via the adapter.
cmd_stop_hook() {
  # Drain host payload; stop_hook_active is informational.
  cat >/dev/null || true
  touch_seat

  if ! watch_on; then
    printf '{}\n'
    return 0
  fi

  # Per-seat budget across distinct packets — stops watch ping-pong.
  if (( $(wake_count) >= WAKE_BUDGET )); then
    set_wake_pending "$(pending_wake_count)"
    printf '{}\n'
    return 0
  fi

  local msgs
  msgs=$(select_unread 0 1 1)
  if [ -z "$msgs" ]; then
    set_wake_pending 0
    printf '{}\n'
    return 0
  fi

  WAKE_REASON="" WAKE_IDS='[]' WAKE_COUNT=0
  build_wake_payload "$msgs"
  bump_wake "$WAKE_IDS"
  set_wake_pending 0

  jq -n -c \
    --arg reason "$WAKE_REASON" \
    --arg msg "agent-bus: $WAKE_COUNT supervisory packet(s) — continuing (wake $(wake_count)/$WAKE_BUDGET)" \
    '{decision:"block",reason:$reason,systemMessage:$msg}'
}

usage() {
  cat <<'EOF'
agent-bus — handoff bus for coding agents sharing repos/worktrees.

  whoami                          show this seat's identity
  who                             list active seats and their claims
  post [flags]                    post a handoff packet
      --to <seat|@here|@repo|@pm|@all|@codex|@claude|@cursor>   default @here
      --state needs-review|blocked|done|fyi|question|handoff
      --subject <text>            defaults to the body's first line
      -m <body> | --file <f> | (stdin)
      --touched a,b,c | --touched auto
      --re <msg-id>               reply to a packet
  read [--peek] [--all] [--quiet] show unread packets (marks read unless --peek)
  show <msg-id>                   full record + body
  resolve <msg-id>...             close a packet for every seat
  claim <path>...                 take an advisory claim (warns if contested)
  release <path>... | --all       drop claims (own claims only)
  claims                          list active claims
  log [n]                         recent packets
  role [pm] [--repo <r>] [--clear]  show/take/release the repo's PM seat
  watch [on|off|status|reset]     opt-in Stop-hook wake on supervisory unread
  doctor                          bus health
  gc                              prune expired claims, stale seats, old bodies
  stop-hook                       lifecycle Stop entry (JSON; used by install-hooks)

Scopes: @here = same repo+worktree, @repo = same repo any worktree,
@pm = the repo's registered PM seat, @codex/@claude/@cursor = that tool in this
repo, @all = everyone. Repo matching uses a stable repo_id (git common-dir hash).

PM role: one seat per repo may hold it (agent-bus role pm). A PM additionally
receives every needs-review, blocked, handoff, and question packet in the repo
regardless of the sender's --to — because --to defaults to @here, which is
worktree-local, and a supervising seat is never in the worker's worktree.

Watch: agent-bus watch on enables Stop-hook continuation when supervisory
packets (needs-review, blocked, handoff, question) are unread. Per-packet
MAX_SHOWS still applies; a separate per-seat WAKE_BUDGET (default 3) caps
distinct-packet wake storms and resets only on agent-bus resolve (or
watch reset) — never on read or watch on/off. Exhaustion with pending mail
is visible in watch status and doctor. Off by default.
A seat idle at an empty prompt (no recent turn) still needs one poke.
EOF
}

# --------------------------------------------------------------------- main

ensure_bus
resolve_identity
cmd="${1:-help}"; shift || true
case "$cmd" in
  whoami) cmd_whoami ;;
  who) touch_seat; cmd_who ;;
  post) touch_seat; cmd_post "$@" ;;
  read) touch_seat; cmd_read "$@" ;;
  digest) touch_seat; cmd_read --digest ;;
  heartbeat) touch_seat ;;
  show) cmd_show "$@" ;;
  resolve) cmd_resolve "$@" ;;
  claim) touch_seat; cmd_claim "$@" ;;
  release) cmd_release "$@" ;;
  claims) cmd_claims ;;
  log) cmd_log "$@" ;;
  role) touch_seat; cmd_role "$@" ;;
  watch) touch_seat; cmd_watch "$@" ;;
  doctor) cmd_doctor ;;
  gc) cmd_gc ;;
  stop-hook) cmd_stop_hook ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
