#!/usr/bin/env bash
# Cursor hook adapter for agent-bus.
#
# Cursor hooks speak JSON on stdin/stdout (unlike Claude/Codex command hooks,
# which inject raw stdout). This wrapper consumes the event payload, runs the
# bus, and returns {additional_context} when there is something to surface.
#
# Note: Cursor's sessionStart additional_context injection has been unreliable
# in the IDE; delivery for Cursor still rests primarily on the skill /
# AGENTS.md instruction layer. Hooks still matter: they update seat telemetry
# so `agent-bus doctor` can see cursor seats firing, and they best-effort inject
# digests when the host cooperates.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="${AGENT_BUS_BIN:-}"
if [ -z "$BIN" ]; then
  if [ -x "$ROOT/bin/agent-bus" ]; then BIN="$ROOT/bin/agent-bus"
  elif command -v agent-bus >/dev/null 2>&1; then BIN="$(command -v agent-bus)"
  else BIN="$HOME/.local/bin/agent-bus"
  fi
fi

EVENT="${1:-sessionStart}"
# Drain stdin so Cursor doesn't block on a full pipe.
cat >/dev/null || true

export AGENT_BUS_VIA=hook
export AGENT_BUS_TOOL="${AGENT_BUS_TOOL:-cursor}"

case "$EVENT" in
  sessionStart)
    "$BIN" heartbeat >/dev/null 2>&1 || true
    digest=$("$BIN" digest 2>/dev/null || true)
    if [ -n "${digest:-}" ]; then
      jq -n --arg c "$digest" '{additional_context:$c}'
    else
      printf '{}\n'
    fi
    ;;
  sessionEnd)
    "$BIN" release --all >/dev/null 2>&1 || true
    printf '{}\n'
    ;;
  *)
    printf '{}\n'
    ;;
esac
